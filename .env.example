# Chatin backend configuration template.
# Copy to .env locally or configure these values in your hosting provider's secret manager.
# Never commit real credentials.

# Required for backend startup (minimum 32 characters; generate with a cryptographically secure generator).
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Server
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL (required for account and message API routes that use the SQL backend).
URL_POSTGRESQL_CLOUD_ANDA=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional AI proxy
GEMINI_API_KEY=""

# Optional S3-compatible private media storage. All four values are required to enable uploads.
S3_ENDPOINT=""
S3_REGION=auto
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# Optional TLS files when Node terminates TLS directly.
# In production, HTTPS termination at a trusted reverse proxy/load balancer is recommended.
SSL_KEY_PATH=./server.key
SSL_CERT_PATH=./server.cert
