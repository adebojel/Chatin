# Safe defaults for Android BuildConfig generation.
# Real credentials must be supplied through an untracked app/.env file or CI secrets.
# Empty quoted strings are intentional: the Secrets Gradle Plugin emits valid Java
# string literals instead of invalid empty assignments.
GEMINI_API_KEY=""
S3_ACCESS_KEY_ID=""
S3_BUCKET_NAME=""
S3_ENDPOINT=""
S3_SECRET_ACCESS_KEY=""
