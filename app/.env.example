# Android Secrets Gradle Plugin defaults for CI builds.
# Use non-empty sentinel strings so generated BuildConfig Java remains valid.
# These are NOT credentials and intentionally disable optional integrations.
# Replace locally only when the corresponding feature is configured.
GEMINI_API_KEY=NOT_CONFIGURED
S3_ACCESS_KEY_ID=NOT_CONFIGURED
S3_BUCKET_NAME=NOT_CONFIGURED
S3_ENDPOINT=NOT_CONFIGURED
S3_SECRET_ACCESS_KEY=NOT_CONFIGURED
